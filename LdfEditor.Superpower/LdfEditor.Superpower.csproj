<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>LdfEditor</RootNamespace>
    <AssemblyName>LdfEditor.Superpower</AssemblyName>
    <ApplicationTitle>LDF Editor (Superpower)</ApplicationTitle>
    <NoWarn>$(NoWarn);CS3021</NoWarn>
    <DefineConstants>$(DefineConstants);LDF_PARSER_SUPERPOWER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Superpower" Version="3.2.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="_smoke\**" />
    <None Remove="_smoke\**" />
    <Page Remove="_smoke\**" />
    <EmbeddedResource Remove="_smoke\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\LdfEditor\App.xaml.cs" Link="App.xaml.cs" DependentUpon="App.xaml" />
    <Compile Include="..\LdfEditor\MainWindow.xaml.cs" Link="MainWindow.xaml.cs" DependentUpon="MainWindow.xaml" />
    <Compile Include="..\LdfEditor\AssemblyInfo.cs" Link="AssemblyInfo.cs" Condition="Exists('..\LdfEditor\AssemblyInfo.cs')" />
    <Compile Include="..\LdfEditor\Controls\**\*.cs" Link="Controls\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\LdfEditor\Converters\**\*.cs" Link="Converters\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\LdfEditor\Models\**\*.cs" Link="Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\LdfEditor\ViewModels\**\*.cs" Link="ViewModels\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\LdfEditor\Views\**\*.cs" Link="Views\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\LdfEditor\Services\**\*.cs" Link="Services\%(RecursiveDir)%(Filename)%(Extension)"
             Exclude="..\LdfEditor\Services\LdfAntlrLoader.cs;..\LdfEditor\Services\NcfAntlrLoader.cs;..\LdfEditor\Services\Diagnostics\LdfDiagnosticEngine.cs" />
    <Compile Include="..\LdfParserCommon\**\*.cs" Link="ParserCommon\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="..\LdfEditor\App.xaml" Link="App.xaml"
                           Generator="MSBuild:Compile" />
    <Page Include="..\LdfEditor\MainWindow.xaml" Link="MainWindow.xaml"
          Generator="MSBuild:Compile" />
    <Page Include="..\LdfEditor\Views\**\*.xaml" Link="Views\%(RecursiveDir)%(Filename)%(Extension)"
          Generator="MSBuild:Compile" />
  </ItemGroup>

  <!-- Stale obj FileList can reference *.g.cs before MarkupCompile; always regenerate markup first. -->
  <Target Name="EnsureLinkedWpfMarkup" BeforeTargets="BeforeCompile" DependsOnTargets="MarkupCompilePass1" />

</Project>
