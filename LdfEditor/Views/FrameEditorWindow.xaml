<Window x:Class="LdfEditor.Views.FrameEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:LdfEditor.Controls"
        Title="Edit Frame" Height="600" Width="780"
        WindowStartupLocation="CenterOwner" Background="#FFF0F0F0"
        MinWidth="640" MinHeight="460" FontFamily="Tahoma" FontSize="11">
  <!-- Layout mirrored from Vector FrameDialogMainControl (LIN): Props / RxTx / Mapped Signals. -->
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <!-- Vector SignalPDUControl: icon tabs on the LEFT edge of the mapping area -->
    <Style x:Key="MapTabControl" TargetType="TabControl">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="#F0F0F0" BorderBrush="#A0A0A0"
                      BorderThickness="1,1,0,1" Padding="2,4,2,4">
                <StackPanel IsItemsHost="True" Orientation="Vertical"
                            VerticalAlignment="Top" HorizontalAlignment="Center"/>
              </Border>
              <Border Grid.Column="1" Background="White" BorderBrush="#A0A0A0"
                      BorderThickness="1" Padding="0">
                <ContentPresenter ContentSource="SelectedContent"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MapTabItem" TargetType="TabItem">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd" Background="#F0F0F0" BorderBrush="#A0A0A0" BorderThickness="1"
                    Width="22" Height="22" SnapsToDevicePixels="True"
                    ToolTip="{TemplateBinding ToolTip}">
              <ContentPresenter ContentSource="Header"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="White"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#316AC5"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E8F0F8"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="White"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MapActionBtn" TargetType="Button">
      <Setter Property="MinWidth" Value="132"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Padding" Value="6,1"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="OK" Width="75" Height="23" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
      <Button Content="Cancel" Width="75" Height="23" IsCancel="True"/>
    </StackPanel>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="85"/>
        <RowDefinition Height="*" MinHeight="220"/>
      </Grid.RowDefinitions>

      <!-- Frame Properties — Vector FrameBasicPropertiesControl_LIN (2 rows) -->
      <GroupBox Grid.Row="0" Header="Frame Properties" Padding="6" Margin="0,0,0,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="85"/>
            <ColumnDefinition Width="33*"/>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="33*"/>
            <ColumnDefinition Width="105"/>
            <ColumnDefinition Width="33*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Name:" VerticalAlignment="Center"/>
          <!-- Vector ErrorProvider: red ! inside Name when not unique -->
          <Grid Grid.Column="1" Grid.ColumnSpan="3" Margin="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="16" Height="16" Margin="0,0,6,0"
                    VerticalAlignment="Center" Background="Transparent" Cursor="Help"
                    Visibility="{Binding HasNameError, Converter={StaticResource BoolToVis}}"
                    ToolTip="{Binding NameErrorTooltip}">
              <Viewbox Stretch="Uniform">
                <Canvas Width="16" Height="16">
                  <Ellipse Width="14" Height="14" Canvas.Left="1" Canvas.Top="1" Fill="#FFE53935"/>
                  <TextBlock Canvas.Left="5.4" Canvas.Top="1.2" Text="!" FontSize="10"
                             FontWeight="Bold" FontFamily="Tahoma" Foreground="White"/>
                </Canvas>
              </Viewbox>
            </Border>
            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"/>
          </Grid>
          <TextBlock Grid.Column="4" Text="Length [Byte]:" VerticalAlignment="Center"/>
          <Grid Grid.Column="5" Margin="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="16" Height="16" Margin="0,0,6,0"
                    VerticalAlignment="Center" Background="Transparent" Cursor="Help"
                    Visibility="{Binding HasLengthError, Converter={StaticResource BoolToVis}}"
                    ToolTip="{Binding LengthErrorTooltip}">
              <Viewbox Stretch="Uniform">
                <Canvas Width="16" Height="16">
                  <Ellipse Width="14" Height="14" Canvas.Left="1" Canvas.Top="1" Fill="#FFE53935"/>
                  <TextBlock Canvas.Left="5.4" Canvas.Top="1.2" Text="!" FontSize="10"
                             FontWeight="Bold" FontFamily="Tahoma" Foreground="White"/>
                </Canvas>
              </Viewbox>
            </Border>
            <TextBox Grid.Column="1" Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"/>
          </Grid>
          <TextBlock Grid.Row="1" Text="ID:" VerticalAlignment="Center"/>
          <Grid Grid.Row="1" Grid.Column="1" Margin="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="16" Height="16" Margin="0,0,6,0"
                    VerticalAlignment="Center" Background="Transparent" Cursor="Help"
                    Visibility="{Binding HasIdError, Converter={StaticResource BoolToVis}}"
                    ToolTip="{Binding IdErrorTooltip}">
              <Viewbox Stretch="Uniform">
                <Canvas Width="16" Height="16">
                  <Ellipse Width="14" Height="14" Canvas.Left="1" Canvas.Top="1" Fill="#FFE53935"/>
                  <TextBlock Canvas.Left="5.4" Canvas.Top="1.2" Text="!" FontSize="10"
                             FontWeight="Bold" FontFamily="Tahoma" Foreground="White"/>
                </Canvas>
              </Viewbox>
            </Border>
            <TextBox Grid.Column="1" Text="{Binding IdHex, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"/>
          </Grid>
        </Grid>
      </GroupBox>

      <!-- Publisher / Subscriber — Vector FrameRxTxControl (stacked rows) -->
      <GroupBox Grid.Row="1" Header="Publisher / Subscriber Relations" Padding="6" Margin="0,0,0,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="85"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Publisher:" VerticalAlignment="Center"/>
          <ComboBox Grid.Column="1" Margin="2"
                    ItemsSource="{Binding PublisherOptions}"
                    SelectedItem="{Binding Publisher, Mode=TwoWay}"/>
          <TextBlock Grid.Row="1" Text="Subscriber(s):" VerticalAlignment="Center"/>
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Subscribers, Mode=OneWay}"
                   IsReadOnly="True" Margin="2"/>
        </Grid>
      </GroupBox>

      <!-- Signal Mapping — Vector SignalPDUControl -->
      <GroupBox Grid.Row="2" Header="Signal Mapping" Padding="4">
        <DockPanel>
          <UniformGrid DockPanel.Dock="Bottom" Rows="1" Columns="4" Margin="0,8,0,0" Height="24">
            <Button Content="Edit Signal" Style="{StaticResource MapActionBtn}" Margin="0,0,6,0"
                    Click="OnEditSignal" IsEnabled="{Binding HasSignalSelection}" HorizontalAlignment="Stretch"/>
            <Button Content="Remove Signal" Style="{StaticResource MapActionBtn}" Margin="0,0,6,0"
                    Click="OnRemoveSignal" IsEnabled="{Binding HasSignalSelection}" HorizontalAlignment="Stretch"/>
            <Button Content="Create and Map Signal" Style="{StaticResource MapActionBtn}" Margin="0,0,6,0"
                    Click="OnCreateAndMap" IsEnabled="{Binding CanCreateAndMap}" HorizontalAlignment="Stretch"/>
            <Button Content="Map Existing Signal" Style="{StaticResource MapActionBtn}" Margin="0"
                    Click="OnMapExisting" IsEnabled="{Binding CanMapExisting}" HorizontalAlignment="Stretch"/>
          </UniformGrid>

          <TabControl Style="{StaticResource MapTabControl}"
                      SelectedIndex="{Binding MapTabIndex, Mode=TwoWay}">
            <TabItem Style="{StaticResource MapTabItem}" ToolTip="List">
              <TabItem.Header>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </TabItem.Header>
              <DataGrid x:Name="SigGrid" ItemsSource="{Binding Signals}" AutoGenerateColumns="False"
                        IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                        SelectedItem="{Binding SelectedSignal, Mode=TwoWay}"
                        MouseDoubleClick="OnSignalGridDoubleClick"
                        BorderThickness="0" RowHeight="22" ColumnHeaderHeight="24">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Signal" Binding="{Binding Name, Mode=OneWay}" Width="160"/>
                  <DataGridTextColumn Header="Startbit" Binding="{Binding StartBit, Mode=OneWay}" Width="70"/>
                  <DataGridTextColumn Header="Length [Bit]" Binding="{Binding Length, Mode=OneWay}" Width="90"/>
                  <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher, Mode=OneWay}" Width="100"/>
                  <DataGridTextColumn Header="Subscribers" Binding="{Binding Subscribers, Mode=OneWay}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Style="{StaticResource MapTabItem}" ToolTip="Layout">
              <TabItem.Header>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80A;" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </TabItem.Header>
              <Border Background="White" Padding="4">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <ctrl:LinBitLayoutControl x:Name="BitLayout" MinHeight="200"
                      Frame="{Binding Frame}"
                      Database="{Binding Database}"
                      SelectedSignalIndex="{Binding SelectedSignalIndex, Mode=TwoWay}"/>
                </ScrollViewer>
              </Border>
            </TabItem>
          </TabControl>
        </DockPanel>
      </GroupBox>
    </Grid>
  </DockPanel>
</Window>
