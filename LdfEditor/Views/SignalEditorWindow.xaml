<Window x:Class="LdfEditor.Views.SignalEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Signal" Height="620" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#FFF0F0F0" FontFamily="Tahoma" FontSize="11"
        MinWidth="560" MinHeight="520">
  <!-- Layout mirrored from Vector SignalDialogMainControl (TableLayout rows: 80 / 55% / 45% / 80). -->
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <Style TargetType="GroupBox">
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="22"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="2"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="22"/>
      <Setter Property="Margin" Value="2"/>
    </Style>
    <Style x:Key="EncBtn" TargetType="Button">
      <Setter Property="Width" Value="70"/>
      <Setter Property="Height" Value="23"/>
      <Setter Property="Margin" Value="3,0,0,0"/>
    </Style>
    <Style x:Key="XferBtn" TargetType="Button">
      <Setter Property="Width" Value="29"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Margin" Value="0,2"/>
    </Style>
    <!-- Vector DevExpress grid navigator: row delete (x/−) and add (+) -->
    <Style x:Key="GridNavBtn" TargetType="Button">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Tahoma"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="EncDataGrid" TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#A0A0A0"/>
      <Setter Property="RowHeight" Value="22"/>
      <Setter Property="ColumnHeaderHeight" Value="22"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="OK" Width="75" Height="23" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
      <Button Content="Cancel" Width="75" Height="23" IsCancel="True"/>
    </StackPanel>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="80"/>
        <RowDefinition Height="55*" MinHeight="160"/>
        <RowDefinition Height="45*" MinHeight="120"/>
        <RowDefinition Height="72"/>
      </Grid.RowDefinitions>

      <!-- Signal Properties (Vector SignalBasicPropertiesControl_LIN) -->
      <GroupBox Grid.Row="0" Header="Signal Properties">
        <Grid Margin="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="30*"/>
            <ColumnDefinition Width="79"/>
            <ColumnDefinition Width="30*"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="65"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Name:" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Grid.ColumnSpan="3"
                   Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Grid.Column="4" Text="Initial Value:" VerticalAlignment="Center" TextWrapping="Wrap"/>
          <!-- Vector: btnEdit visible only when InitValueIsByteArray; scalar spans full width -->
          <DockPanel Grid.Column="5" Grid.ColumnSpan="2">
            <Button DockPanel.Dock="Right" Content="Edit" Height="22" MinWidth="52" Margin="4,0,0,0"
                    Command="{Binding EditInitValueCommand}"
                    Visibility="{Binding IsByteArrayType, Converter={StaticResource BoolToVis}}"
                    ToolTip="Edit byte-array initial value"/>
            <TextBox Text="{Binding InitValue, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsByteArrayType}"/>
          </DockPanel>

          <TextBlock Grid.Row="1" Text="Signal Type:" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="1" Grid.Column="1"
                    ItemsSource="{Binding SignalTypes}"
                    SelectedItem="{Binding SignalType, Mode=TwoWay}"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="Length [Bit]:" VerticalAlignment="Center" Margin="4,0,0,0"/>
          <TextBox Grid.Row="1" Grid.Column="3"
                   Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
      </GroupBox>

      <!-- Encoding Type -->
      <GroupBox Grid.Row="1" Header="Encoding Type" Margin="0,6,0,0">
        <DockPanel LastChildFill="True">
          <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding EncodingNames}"
                      SelectedItem="{Binding SelectedEncodingName, Mode=TwoWay}"
                      MaxWidth="320" HorizontalAlignment="Left" Width="260"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="Rename" Style="{StaticResource EncBtn}" Command="{Binding RenameEncodingCommand}"/>
              <Button Content="Create" Style="{StaticResource EncBtn}" Command="{Binding CreateEncodingCommand}"/>
              <Button Content="Delete" Style="{StaticResource EncBtn}" Command="{Binding DeleteEncodingCommand}"/>
            </StackPanel>
          </Grid>

          <TabControl SelectedIndex="{Binding EncodingPage, Mode=TwoWay}">
            <!-- Vector SignalEncodingsPhysicalControl: fields + Add Physical Encoding when empty -->
            <TabItem Header="Physical">
              <DockPanel Margin="10,10" IsEnabled="{Binding CanEditScalarEncoding}">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock Text="{Binding PhysicalEncodingInfo}" VerticalAlignment="Center"
                             Foreground="#666" Margin="0,0,10,0" TextWrapping="Wrap" MaxWidth="320"/>
                  <Button Content="Add Physical Encoding" Height="23" Padding="10,1"
                          Command="{Binding AddPhysicalEncodingCommand}"
                          Visibility="{Binding ShowAddPhysicalEncoding, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <Grid IsEnabled="{Binding CanEditPhysicalFields}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/><ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="100"/><ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="40"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="Minimum [raw]:" VerticalAlignment="Center"/>
                  <TextBox Grid.Column="1" Text="{Binding PhysMin, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Grid.Column="2" Text="Maximum [raw]:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  <TextBox Grid.Column="3" Text="{Binding PhysMax, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Grid.Column="4" Text="Unit:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  <TextBox Grid.Column="5" Text="{Binding PhysUnit, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Grid.Row="1" Text="Factor:" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PhysFactor, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="Offset:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding PhysOffset, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
              </DockPanel>
            </TabItem>
            <!-- Vector SignalEncodingsLogicalControl: DevExpress − / + navigator -->
            <TabItem Header="Logical (Text Table)">
              <DockPanel Margin="2" IsEnabled="{Binding CanEditScalarEncoding}">
                <Button DockPanel.Dock="Bottom" Content="+" Style="{StaticResource GridNavBtn}"
                        HorizontalAlignment="Left" Margin="2,2,0,2"
                        Command="{Binding AddLogicalRowCommand}" ToolTip="Add"/>
                <DataGrid ItemsSource="{Binding LogicalRows}" Style="{StaticResource EncDataGrid}">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Width="26" CanUserResize="False">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Button Content="×" Style="{StaticResource GridNavBtn}" ToolTip="Delete"
                                  Command="{Binding DataContext.RemoveLogicalRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Value [raw]" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </TabItem>
            <!-- Vector SignalEncodingsMultiRangeControl: all physical ranges with − / + -->
            <TabItem Header="Multi-Range">
              <DockPanel Margin="2" IsEnabled="{Binding CanEditScalarEncoding}">
                <Button DockPanel.Dock="Bottom" Content="+" Style="{StaticResource GridNavBtn}"
                        HorizontalAlignment="Left" Margin="2,2,0,2"
                        Command="{Binding AddPhysicalRowCommand}" ToolTip="Add"/>
                <DataGrid ItemsSource="{Binding PhysicalRows}" Style="{StaticResource EncDataGrid}">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Width="26" CanUserResize="False">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Button Content="×" Style="{StaticResource GridNavBtn}" ToolTip="Delete"
                                  Command="{Binding DataContext.RemovePhysicalRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Minimum [raw]" Binding="{Binding Min, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    <DataGridTextColumn Header="Maximum [raw]" Binding="{Binding Max, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    <DataGridTextColumn Header="Factor" Binding="{Binding Factor, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridTextColumn Header="Offset" Binding="{Binding Offset, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </TabItem>
            <!-- Vector: SupportLINFloatEncoding=false for LDF Explorer → "ASCII / BCD" only -->
            <TabItem Header="ASCII / BCD">
              <Grid Margin="16,12" IsEnabled="{Binding CanEditEncoding}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="84"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="28"/><RowDefinition Height="28"/>
                  <RowDefinition Height="28"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="2" Text="Hint: Uncheck checkbox to be able to assign other encodings."
                           Foreground="#666" Margin="0,0,0,8"
                           Visibility="{Binding ShowAsciiBcdHint, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Grid.Row="1" Text="ASCII:" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding IsAscii, Mode=TwoWay}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Text="BCD:" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding IsBcd, Mode=TwoWay}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Text="Float:" VerticalAlignment="Center"
                           Visibility="{Binding SupportLinFloatEncoding, Converter={StaticResource BoolToVis}}"/>
                <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding IsFloat, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Visibility="{Binding SupportLinFloatEncoding, Converter={StaticResource BoolToVis}}"/>
              </Grid>
            </TabItem>
          </TabControl>
        </DockPanel>
      </GroupBox>

      <!-- Publisher / Subscriber Relations (Vector SignalRxTxControl) -->
      <GroupBox Grid.Row="2" Header="Publisher / Subscriber Relations" Margin="0,6,0,0">
        <Grid Margin="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="29"/>
            <ColumnDefinition Width="60*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Publisher:" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Text="{Binding Publisher, Mode=OneWay}" IsReadOnly="True"
                   Width="160" HorizontalAlignment="Left"/>
          <TextBlock Grid.Row="1" Text="ECUs" Margin="0,4,0,2"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Text="Subscriber(s)" Margin="16,4,0,2"/>
          <ListBox Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding EcuList}"
                   SelectedItem="{Binding SelectedEcu, Mode=TwoWay}"
                   MouseDoubleClick="OnEcuDoubleClick"
                   BorderBrush="#A0A0A0" BorderThickness="1" Margin="0,0,4,0"/>
          <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="&lt;" Style="{StaticResource XferBtn}" Command="{Binding RemoveSubscriberCommand}"/>
            <Button Content="&gt;" Style="{StaticResource XferBtn}" Command="{Binding AddSubscriberCommand}"/>
          </StackPanel>
          <ListBox Grid.Row="2" Grid.Column="3" ItemsSource="{Binding Subscribers}"
                   SelectedItem="{Binding SelectedSubscriber, Mode=TwoWay}"
                   MouseDoubleClick="OnSubscriberDoubleClick"
                   BorderBrush="#A0A0A0" BorderThickness="1" Margin="4,0,0,0"/>
        </Grid>
      </GroupBox>

      <!-- Mapping (Vector SignalMappingControl_LIN) -->
      <GroupBox Grid.Row="3" Header="Mapping" Margin="0,6,0,0">
        <Grid Margin="4,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="20*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding PositionLabel, Mode=OneWay}" VerticalAlignment="Center"/>
          <!-- Vector ErrorProvider: warning glyph inside left of Position textbox -->
          <Grid Grid.Column="1" Margin="10,2,2,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="16" Height="16" Margin="0,0,6,0"
                    VerticalAlignment="Center" Background="Transparent" Cursor="Help"
                    Visibility="{Binding HasPositionError, Converter={StaticResource BoolToVis}}"
                    ToolTip="{Binding PositionErrorTooltip}">
              <Viewbox Stretch="Uniform">
                <Canvas Width="16" Height="16">
                  <Path Fill="#FFFFC107" Stroke="#FFB71C1C" StrokeThickness="0.8"
                        Data="M8,1.5 L14.5,14 L1.5,14 Z"/>
                  <TextBlock Canvas.Left="5.2" Canvas.Top="5.5" Text="!" FontSize="8"
                             FontWeight="Bold" FontFamily="Tahoma" Foreground="#FFB71C1C"/>
                </Canvas>
              </Viewbox>
            </Border>
            <TextBox Grid.Column="1" Text="{Binding StartBit, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"/>
          </Grid>
          <TextBlock Grid.Column="2" Text="Byte Order:" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <ComboBox Grid.Column="3" IsEnabled="False"
                    ItemsSource="{Binding ByteOrders}" SelectedItem="{Binding ByteOrder, Mode=OneWay}"/>
        </Grid>
      </GroupBox>
    </Grid>
  </DockPanel>
</Window>
