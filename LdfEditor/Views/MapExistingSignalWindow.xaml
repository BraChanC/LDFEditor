<Window x:Class="LdfEditor.Views.MapExistingSignalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Map Existing Signal" Height="360" Width="340"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F0F0F0" FontFamily="Tahoma" FontSize="11"
        MinWidth="280" MinHeight="240" ShowInTaskbar="False">
  <!-- Vector MapExistingElementDialog&lt;Signal&gt; -->
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="OK" Width="75" Height="23" Margin="0,0,8,0" IsDefault="True" Click="OnOk"
              IsEnabled="{Binding HasSelection}"/>
      <Button Content="Cancel" Width="75" Height="23" IsCancel="True"/>
    </StackPanel>
    <Border BorderBrush="#A0A0A0" BorderThickness="1" Background="White">
      <DataGrid ItemsSource="{Binding Signals}"
                SelectedItem="{Binding SelectedSignal, Mode=TwoWay}"
                AutoGenerateColumns="False" IsReadOnly="True"
                HeadersVisibility="Column" CanUserAddRows="False"
                SelectionMode="Single" SelectionUnit="FullRow"
                BorderThickness="0" RowHeight="22" ColumnHeaderHeight="24"
                MouseDoubleClick="OnDoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Signal" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
          <DataGridTextColumn Header="Length [Bit]" Binding="{Binding SizeBits, Mode=OneWay}" Width="90"/>
          <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher, Mode=OneWay}" Width="90"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</Window>
