<Application x:Class="LdfEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LdfEditor.Converters"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <conv:InverseBoolToVisConverter x:Key="InvBoolToVis"/>
    <conv:NullToVisConverter x:Key="NullToVis"/>

    <!-- Vector LDF Explorer / classic WinForms palette -->
    <SolidColorBrush x:Key="Vec.Bg" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Vec.Panel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Vec.Border" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Vec.Header" Color="#ECE9D8"/>
    <SolidColorBrush x:Key="Vec.Caption" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="Vec.Accent" Color="#000080"/>
    <SolidColorBrush x:Key="Vec.AccentSoft" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="Vec.CatBg" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="Vec.NameFg" Color="#000000"/>
    <SolidColorBrush x:Key="Vec.Split" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="Vec.GridLine" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="Vec.SelBg" Color="#316AC5"/>
    <SolidColorBrush x:Key="Vec.SelFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Vec.ToolStrip" Color="#F5F4EC"/>

    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Tahoma"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Background" Value="{StaticResource Vec.Bg}"/>
    </Style>

    <Style TargetType="Menu">
      <Setter Property="FontFamily" Value="Tahoma"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Background" Value="{StaticResource Vec.Header}"/>
    </Style>

    <Style x:Key="Vec.SectionTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Tahoma"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#000000"/>
      <Setter Property="Margin" Value="4,2,4,2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Classic docked panel: flat gray border, no radius -->
    <Style x:Key="Vec.PanelBorder" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Vec.Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Vec.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Pane caption bar (Schedule Tables / Properties) -->
    <Style x:Key="Vec.HeaderBar" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Vec.Caption}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Vec.Border}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="2,1"/>
      <Setter Property="MinHeight" Value="22"/>
    </Style>

    <!-- ListView-like DataGrid -->
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowBackground" Value="White"/>
      <Setter Property="AlternatingRowBackground" Value="White"/>
      <Setter Property="GridLinesVisibility" Value="All"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#E8E8E8"/>
      <Setter Property="VerticalGridLinesBrush" Value="#E8E8E8"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="RowHeight" Value="18"/>
      <Setter Property="ColumnHeaderHeight" Value="20"/>
      <Setter Property="FontFamily" Value="Tahoma"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource Vec.Caption}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Vec.Border}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="Padding" Value="4,1"/>
      <Setter Property="FontFamily" Value="Tahoma"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#000000"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="3,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource Vec.SelBg}"/>
          <Setter Property="Foreground" Value="{StaticResource Vec.SelFg}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="White"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource Vec.SelBg}"/>
          <Setter Property="Foreground" Value="{StaticResource Vec.SelFg}"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#E8F0F8"/>
        </Trigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="IsSelected" Value="True"/>
            <Condition Property="IsMouseOver" Value="True"/>
          </MultiTrigger.Conditions>
          <Setter Property="Background" Value="{StaticResource Vec.SelBg}"/>
        </MultiTrigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="TreeView">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="1"/>
      <Setter Property="FontFamily" Value="Tahoma"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style TargetType="TreeViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="0,0"/>
      <Setter Property="FontFamily" Value="Tahoma"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- PropertyGrid-like tree -->
    <Style x:Key="Vec.PropTreeView" TargetType="TreeView" BasedOn="{StaticResource {x:Type TreeView}}">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="White"/>
    </Style>
    <Style x:Key="Vec.PropTreeItem" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
      <Setter Property="IsExpanded" Value="True"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <StackPanel>
              <Border x:Name="Bd" Background="Transparent" Padding="0" SnapsToDevicePixels="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <ToggleButton x:Name="Expander" Grid.Column="0"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                ClickMode="Press" Focusable="False"
                                Width="12" Height="12" Margin="0,3,0,0" VerticalAlignment="Top">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                          <Path x:Name="Arrow" Data="M0,0 L0,8 L6,4 Z" Fill="#000"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="Data" Value="M0,0 L8,0 L4,6 Z"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                  <ContentPresenter Grid.Column="1" ContentSource="Header"
                                    HorizontalAlignment="Stretch"/>
                </Grid>
              </Border>
              <ItemsPresenter x:Name="ItemsHost" Margin="12,0,0,0"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
              </Trigger>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <HierarchicalDataTemplate x:Key="Vec.PropItemTemplate" ItemsSource="{Binding Children}">
      <Border BorderBrush="{StaticResource Vec.GridLine}" BorderThickness="0,0,0,1"
              SnapsToDevicePixels="True" MinHeight="20">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsCategory}" Value="True">
                <Setter Property="Background" Value="{StaticResource Vec.CatBg}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!-- Category: full-width label -->
          <TextBlock Grid.ColumnSpan="2" Text="{Binding Name}" Margin="2,2,2,2"
                     FontWeight="Bold" FontFamily="Tahoma" FontSize="11" Foreground="#000"
                     Visibility="{Binding IsCategory, Converter={StaticResource BoolToVis}}"/>
          <!-- Leaf name -->
          <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0"
                  Padding="4,1,2,1"
                  Visibility="{Binding IsCategory, Converter={StaticResource InvBoolToVis}}">
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                       FontFamily="Tahoma" FontSize="11" Foreground="#000"
                       TextTrimming="CharacterEllipsis"/>
          </Border>
          <Border Grid.Column="1" Padding="2,0,2,0"
                  Visibility="{Binding IsCategory, Converter={StaticResource InvBoolToVis}}">
            <Grid>
              <TextBlock Text="{Binding Value}" VerticalAlignment="Center"
                         FontFamily="Tahoma" FontSize="11" Foreground="#000"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         Visibility="{Binding IsPlainValue, Converter={StaticResource BoolToVis}}"/>
              <Grid Visibility="{Binding IsTextEditor, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="14" Height="14" Margin="0,0,4,0"
                        VerticalAlignment="Center" Background="Transparent" Cursor="Help"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding ErrorTooltip}">
                  <Viewbox Stretch="Uniform">
                    <Canvas Width="16" Height="16">
                      <Path Fill="#FFFFC107" Stroke="#FFB71C1C" StrokeThickness="0.8"
                            Data="M8,1.5 L14.5,14 L1.5,14 Z"/>
                      <TextBlock Canvas.Left="5.2" Canvas.Top="5.5" Text="!" FontSize="8"
                                 FontWeight="Bold" FontFamily="Tahoma" Foreground="#FFB71C1C"/>
                    </Canvas>
                  </Viewbox>
                </Border>
                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                         FontFamily="Tahoma" FontSize="11"
                         VerticalContentAlignment="Center" Height="18" Padding="1,0"
                         BorderThickness="1" BorderBrush="#7F9DB9" Background="White"/>
              </Grid>
              <ComboBox ItemsSource="{Binding Options}"
                        SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                        IsEditable="False"
                        FontFamily="Tahoma" FontSize="11"
                        Height="18" Padding="1,0"
                        Visibility="{Binding IsComboEditor, Converter={StaticResource BoolToVis}}"/>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </HierarchicalDataTemplate>

    <!-- Classic WinForms tab strip (Frames/Commands | Nodes/Frames) -->
    <Style x:Key="Vec.NavTabControl" TargetType="TabControl">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#A0A0A0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="{StaticResource Vec.Header}" BorderBrush="#A0A0A0"
                      BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                <TabPanel IsItemsHost="True" Background="Transparent" Margin="2,3,2,0"/>
              </Border>
              <Border Grid.Row="1" Background="White" BorderBrush="#A0A0A0" BorderThickness="0">
                <ContentPresenter ContentSource="SelectedContent"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Vec.NavTabItem" TargetType="TabItem">
      <Setter Property="Foreground" Value="#000000"/>
      <Setter Property="FontFamily" Value="Tahoma"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd" Background="{StaticResource Vec.Header}" BorderBrush="#A0A0A0"
                    BorderThickness="1,1,1,0" Margin="0,0,1,0" Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter ContentSource="Header"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="White"/>
                <Setter TargetName="Bd" Property="Margin" Value="0,0,1,-1"/>
                <Setter TargetName="Bd" Property="Panel.ZIndex" Value="1"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="False"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="#F5F4EC"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Detail List/Layout tabs — flat classic -->
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="{StaticResource Vec.Caption}" BorderBrush="#A0A0A0"
                      BorderThickness="0,0,0,1">
                <TabPanel IsItemsHost="True" Margin="2,2,2,0"/>
              </Border>
              <Border Grid.Row="1" Background="White">
                <ContentPresenter ContentSource="SelectedContent"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="10,2"/>
      <Setter Property="FontFamily" Value="Tahoma"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd" Background="{StaticResource Vec.Caption}" BorderBrush="#A0A0A0"
                    BorderThickness="1,1,1,0" Margin="0,0,1,0" Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="White"/>
                <Setter TargetName="Bd" Property="Margin" Value="0,0,1,-1"/>
                <Setter TargetName="Bd" Property="Panel.ZIndex" Value="1"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="GridSplitter">
      <Setter Property="Background" Value="{StaticResource Vec.Split}"/>
      <Setter Property="ShowsPreview" Value="False"/>
    </Style>

    <Style TargetType="StatusBar">
      <Setter Property="Background" Value="{StaticResource Vec.Header}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Vec.Border}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="FontFamily" Value="Tahoma"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="Vec.TbIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Vec.TbButton" TargetType="Button">
      <Setter Property="Padding" Value="3,1"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C1D2EE"/>
          <Setter Property="BorderBrush" Value="#316AC5"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#A9C0E6"/>
          <Setter Property="BorderBrush" Value="#316AC5"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Vec.TbHex" TargetType="ToggleButton">
      <Setter Property="Content" Value="hex"/>
      <Setter Property="FontFamily" Value="Tahoma"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="5,1"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#7F9DB9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#000080"/>
      <Setter Property="Focusable" Value="False"/>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="#C1D2EE"/>
          <Setter Property="BorderBrush" Value="#316AC5"/>
          <Setter Property="Foreground" Value="#000080"/>
        </Trigger>
        <Trigger Property="IsChecked" Value="False">
          <Setter Property="Background" Value="#F0F0F0"/>
          <Setter Property="BorderBrush" Value="#A0A0A0"/>
          <Setter Property="Foreground" Value="#666"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Vec.TbMenu" TargetType="Menu">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="Vec.TbMenuItem" TargetType="MenuItem">
      <Setter Property="Padding" Value="3,1"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </Application.Resources>
</Application>
