<Application x:Class="LdfEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LdfEditor.Converters"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <conv:InverseBoolToVisConverter x:Key="InvBoolToVis"/>
    <conv:NullToVisConverter x:Key="NullToVis"/>

    <SolidColorBrush x:Key="Vec.Bg" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="Vec.Panel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Vec.Border" Color="#C8CCD0"/>
    <SolidColorBrush x:Key="Vec.Header" Color="#E8EAED"/>
    <SolidColorBrush x:Key="Vec.Accent" Color="#3A6EA5"/>
    <SolidColorBrush x:Key="Vec.AccentSoft" Color="#D6E4F0"/>
    <SolidColorBrush x:Key="Vec.CatBg" Color="#EBEBEB"/>
    <SolidColorBrush x:Key="Vec.NameFg" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="Vec.Split" Color="#B0B4B8"/>
    <SolidColorBrush x:Key="Vec.GridLine" Color="#E0E3E6"/>

    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="{StaticResource Vec.Bg}"/>
    </Style>

    <Style x:Key="Vec.SectionTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#2C3E50"/>
      <Setter Property="Margin" Value="6,4,6,4"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Vec.PanelBorder" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Vec.Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Vec.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Vec.HeaderBar" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Vec.Header}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Vec.Border}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="2,0"/>
      <Setter Property="MinHeight" Value="26"/>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowBackground" Value="White"/>
      <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#E6E8EB"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="RowHeight" Value="22"/>
      <Setter Property="ColumnHeaderHeight" Value="24"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource Vec.Header}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Vec.Border}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#333"/>
    </Style>

    <Style TargetType="TreeView">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="2"/>
    </Style>

    <!--
      Default TreeViewItem binds H/V ContentAlignment via RelativeSource ItemsControl.
      While containers are created (e.g. refreshing BusProps after selecting RSM_Frm1),
      DataContext is null and ancestor lookup fails → VS XAML Binding Failures spam.
      Override with literals; no FindAncestor needed.
    -->
    <Style TargetType="TreeViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="0,1"/>
    </Style>

    <!-- Right property panes (Schedule Props / Object Props): Name|Value grid with lines -->
    <Style x:Key="Vec.PropTreeView" TargetType="TreeView" BasedOn="{StaticResource {x:Type TreeView}}">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="White"/>
    </Style>
    <Style x:Key="Vec.PropTreeItem" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
      <Setter Property="IsExpanded" Value="True"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <HierarchicalDataTemplate x:Key="Vec.PropItemTemplate" ItemsSource="{Binding Children}">
      <Border BorderBrush="{StaticResource Vec.GridLine}" BorderThickness="0,0,0,1"
              SnapsToDevicePixels="True" MinHeight="22">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsCategory}" Value="True">
                <Setter Property="Background" Value="{StaticResource Vec.CatBg}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="{StaticResource Vec.GridLine}" BorderThickness="0,0,1,0"
                  Padding="6,2,4,2">
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource Vec.NameFg}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCategory}" Value="True">
                      <Setter Property="FontWeight" Value="SemiBold"/>
                      <Setter Property="Foreground" Value="#1A1A1A"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
          <Border Grid.Column="1" Padding="6,2,4,2">
            <TextBlock Text="{Binding Value}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="#111"/>
          </Border>
        </Grid>
      </Border>
    </HierarchicalDataTemplate>

    <!-- Vector LDF Explorer style: flat top tabs (Frames/Commands | Nodes/Frames) -->
    <Style x:Key="Vec.NavTabControl" TargetType="TabControl">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#A0A0A0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#ECE9D8" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1"
                      SnapsToDevicePixels="True">
                <TabPanel IsItemsHost="True" Background="Transparent" Margin="2,3,2,0"/>
              </Border>
              <Border Grid.Row="1" Background="White" BorderBrush="#A0A0A0" BorderThickness="0">
                <ContentPresenter ContentSource="SelectedContent"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Vec.NavTabItem" TargetType="TabItem">
      <Setter Property="Foreground" Value="#000000"/>
      <Setter Property="FontFamily" Value="Tahoma"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd" Background="#ECE9D8" BorderBrush="#A0A0A0"
                    BorderThickness="1,1,1,0" Margin="0,0,1,0" Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter ContentSource="Header"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="White"/>
                <Setter TargetName="Bd" Property="Margin" Value="0,0,1,-1"/>
                <Setter TargetName="Bd" Property="Panel.ZIndex" Value="1"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="False"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="#F5F4EC"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Vec.Border}"
                    BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Margin="0,0,2,0" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Vec.AccentSoft}"/>
                <Setter Property="Foreground" Value="{StaticResource Vec.Accent}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#EEF2F6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="GridSplitter">
      <Setter Property="Background" Value="{StaticResource Vec.Split}"/>
      <Setter Property="ShowsPreview" Value="True"/>
    </Style>

    <Style TargetType="StatusBar">
      <Setter Property="Background" Value="{StaticResource Vec.Header}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Vec.Border}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="Padding" Value="8,3"/>
    </Style>

    <!-- Vector LDF Explorer toolbar (WinForms ToolStrip look) -->
    <Style x:Key="Vec.TbIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Vec.TbButton" TargetType="Button">
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#DCE6F0"/>
          <Setter Property="BorderBrush" Value="#A0B8D0"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Vec.TbHex" TargetType="ToggleButton">
      <Setter Property="Content" Value="hex"/>
      <Setter Property="FontFamily" Value="Tahoma"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#3A6EA5"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#3A6EA5"/>
      <Setter Property="Focusable" Value="False"/>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="#D6E4F0"/>
          <Setter Property="BorderBrush" Value="#2A5A8A"/>
          <Setter Property="Foreground" Value="#1E4A75"/>
        </Trigger>
        <Trigger Property="IsChecked" Value="False">
          <Setter Property="Background" Value="#F0F0F0"/>
          <Setter Property="BorderBrush" Value="#A0A0A0"/>
          <Setter Property="Foreground" Value="#666"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Vec.TbMenu" TargetType="Menu">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="Vec.TbMenuItem" TargetType="MenuItem">
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </Application.Resources>
</Application>
